# Copy this file to backend/.env and fill in the values.

# Supabase dashboard → "Connect" → Connection string → "Session pooler" (works over IPv4).
# Paste the URI and replace [YOUR-PASSWORD] with your database password
# (URL-encode special characters such as @ or #). Don't add ?sslmode=… to it.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional but recommended: verifies that you're really talking to Supabase.
# Supabase dashboard → Database settings → SSL Configuration → Download certificate,
# save it next to this file and put its file name here (relative to backend/).
DATABASE_CA_CERT=

# Signs sign-in tokens. Any random string of at least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the API listens on.
PORT=3000
