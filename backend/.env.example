# Copy this file to backend/.env and fill in the values:
#   cp backend/.env.example backend/.env

# ── Database ────────────────────────────────────────────────────────────────
# Supabase dashboard → your project → "Connect" (top bar) → "Connection String"
# tab → Type: URI → Method: "Session pooler" (works over IPv4).
# Copy the WHOLE string exactly as shown. Do not keep the example below:
#   - user is "postgres.<PROJECT-REF>" (the ref is in your dashboard URL:
#     supabase.com/dashboard/project/<PROJECT-REF>)
#   - host depends on your project's region AND cluster (aws-0-… or aws-1-…),
#     so always copy it from the dashboard
#   - port 5432 (session pooler), database "postgres"
# Replace [YOUR-PASSWORD] with the database password (Dashboard → Database
# settings → Reset database password if you don't know it). Remove the [ ].
# URL-encode special characters in the password: @ → %40, # → %23, / → %2F,
# : → %3A, ? → %3F. Don't add ?sslmode=… (SSL is configured in code).
#
# "tenant/user … not found"  → wrong project ref or wrong host/region: copy again.
# "password authentication failed" → wrong password or not URL-encoded.
# "ENOTFOUND" / timeout  → project paused or deleted: restore it in the dashboard.
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Optional: verifies that you're really talking to Supabase. Leave empty to skip.
# This is a certificate FILE, not a Supabase API key. No Supabase API keys
# (anon, service_role, sb_publishable_…, sb_secret_…) are used anywhere.
# Dashboard → Database settings → SSL Configuration → Download certificate,
# save the file in backend/ and put its file name here, e.g. prod-ca-2021.crt
DATABASE_CA_CERT=

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs sign-in tokens. Any random string of at least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
# Port the API listens on.
PORT=3000
